<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llModelItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvModelDisplayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPT-4o Mini"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModelContextLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="128k context"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Capability Tags Container -->
    <LinearLayout
        android:id="@+id/llModelTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <!-- Radio / Check Indicator -->
    <ImageView
        android:id="@+id/ivModelSelectedCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_sparkle_agent"
        android:tint="@color/puter_blue"
        android:visibility="gone" />

</LinearLayout>
